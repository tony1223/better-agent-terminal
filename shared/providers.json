{
  "schemaVersion": 1,
  "defaultPreset": "claude-code",
  "runtimeDefaultPresets": {
    "claude": "claude-code",
    "codex": "codex-agent"
  },
  "menuOrder": [
    "claude-code",
    "claude-channel",
    "codex-agent",
    "claude-cli",
    "codex-cli",
    "claude-code-worktree",
    "codex-agent-worktree",
    "claude-cli-worktree"
  ],
  "providers": [
    {
      "id": "claude",
      "label": "Claude",
      "runtime": "claude",
      "auth": "claude-oauth",
      "usage": "anthropic-oauth",
      "defaultEnabled": true
    },
    {
      "id": "codex",
      "label": "Codex",
      "runtime": "codex",
      "auth": "codex-oauth",
      "usage": "codex-rate-limits",
      "defaultEnabled": true
    },
    {
      "id": "fugu",
      "label": "Fugu (Sakana)",
      "runtime": "codex",
      "auth": "api-key",
      "apiKeyStore": "codex-env",
      "usage": "none",
      "defaultEnabled": true,
      "debugOnly": true,
      "defaultModel": "fugu"
    }
  ],
  "presets": [
    {
      "id": "claude-code",
      "provider": "claude",
      "panel": "claude-agent",
      "name": "Claude Agent",
      "icon": "✦",
      "color": "#d97706",
      "command": "claude --continue",
      "suggested": true,
      "backend": "sdk",
      "apiVersionSwitch": "claude-code-v2"
    },
    {
      "id": "claude-code-v2",
      "provider": "claude",
      "panel": "claude-agent",
      "hidden": true,
      "name": "Claude Agent V2",
      "icon": "✦",
      "color": "#eab308",
      "debug": true,
      "backend": "sdk",
      "apiVersion": "v2",
      "apiVersionSwitch": "claude-code"
    },
    {
      "id": "claude-channel",
      "provider": "claude",
      "panel": "claude-channel",
      "name": "Claude Channel Agent",
      "icon": "◉",
      "color": "#f97316",
      "debug": true,
      "backend": "channel"
    },
    {
      "id": "claude-cli-agent",
      "provider": "claude",
      "panel": "claude-cli-agent",
      "name": "Claude CLI Agent (Subscription)",
      "icon": "◈",
      "color": "#d97706",
      "debug": true,
      "backend": "cli",
      "ptyImagePaste": true
    },
    {
      "id": "claude-code-worktree",
      "provider": "claude",
      "panel": "claude-agent",
      "name": "Claude Agent (Worktree)",
      "icon": "✦",
      "color": "#22c55e",
      "backend": "sdk",
      "needsGitRepo": true
    },
    {
      "id": "claude-cli",
      "provider": "claude",
      "panel": "claude-cli",
      "name": "Claude CLI",
      "icon": "▶",
      "color": "#d97706",
      "suggested": true,
      "backend": "cli",
      "ptyImagePaste": true
    },
    {
      "id": "claude-cli-worktree",
      "provider": "claude",
      "panel": "claude-cli",
      "name": "Claude CLI (Worktree)",
      "icon": "▶",
      "color": "#22c55e",
      "backend": "cli",
      "needsGitRepo": true,
      "ptyImagePaste": true
    },
    {
      "id": "codex-agent",
      "provider": "codex",
      "panel": "codex-agent",
      "name": "Codex Agent",
      "icon": "⬡",
      "color": "#10a37f",
      "backend": "sdk",
      "aliases": [
        "openai-agent"
      ]
    },
    {
      "id": "codex-agent-worktree",
      "provider": "codex",
      "panel": "codex-agent",
      "name": "Codex Agent (Worktree)",
      "icon": "⬡",
      "color": "#10a37f",
      "backend": "sdk",
      "needsGitRepo": true
    },
    {
      "id": "codex-fugu",
      "provider": "fugu",
      "panel": "codex-agent",
      "name": "Codex Fugu Agent",
      "icon": "🐡",
      "color": "#06b6d4",
      "backend": "sdk",
      "debug": true
    },
    {
      "id": "codex-cli",
      "provider": "codex",
      "panel": "terminal",
      "name": "Codex CLI",
      "icon": "▶",
      "color": "#10a37f",
      "backend": "pty",
      "ptyImagePaste": true,
      "ptyCommand": {
        "default": "codex",
        "bypassPermissions": "codex --yolo"
      }
    },
    {
      "id": "none",
      "provider": null,
      "panel": "terminal",
      "name": "Terminal",
      "icon": "⌘",
      "color": "#888888"
    }
  ]
}
